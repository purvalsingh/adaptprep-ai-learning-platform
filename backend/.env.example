# All settings are optional — AdaptPrep runs with zero configuration.
PORT=5000

# Secret used to sign login tokens. If unset, a strong secret is generated
# on first run and stored in the data file. Set it explicitly in production.
JWT_SECRET=
JWT_EXPIRE=7d

# Comma-separated origins allowed to call the API from a browser (dev servers).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Where data is stored. Use ":memory:" for a throwaway database.
DB_FILE=

# Demo workspace (admin, teacher, students, classes) on first run. Set to
# false for a clean install and use ADMIN_EMAIL/ADMIN_PASSWORD instead.
SEED_DEMO=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: plug in Google Gemini. Without a key the built-in
# "AdaptPrep Local AI" engine powers every AI feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
